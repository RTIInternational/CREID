                          "required": [
                            "name"
                          ],
                          "recommended": [
                            "url"
                          ],
                          "optional": [
                            "dateModified"
                          ],
                          "type": "object"
                        }
                      ]
                    },
                    "termCode": {
                      "description": "A code that identifies this DefinedTerm within a DefinedTermSet.",
                      "type": "string"
                    },
                    "description": {
                      "description": "A description of the item.",
                      "type": "string"
